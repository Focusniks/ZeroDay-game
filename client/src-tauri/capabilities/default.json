{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for ZeroDay (IPC + core)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-game-config",
    "allow-get-game-config-path",
    "allow-save-game-config",
    "allow-fs-init",
    "allow-fs-root-path",
    "allow-fs-list",
    "allow-fs-mkdir",
    "allow-fs-delete",
    "allow-fs-read-text",
    "allow-fs-write-text",
    "allow-fs-read-bytes",
    "allow-fs-write-bytes",
    "allow-fs-move"
  ]
}
